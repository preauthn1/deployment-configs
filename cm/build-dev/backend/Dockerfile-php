FROM node:alpine AS node-build
RUN apk update && apk add nodejs npm
COPY app /app
WORKDIR /app
# RUN rm /app/package-lock.json
RUN npm install
RUN npm run build
RUN ls -al /app/public/

FROM asia-east1-docker.pkg.dev/tp-wz3-rd/bucket2024/target/docker-base/phpbase/8.3
RUN apt-get update && apt-get install -y nodejs npm cron
COPY --from=node-build /app /app
WORKDIR /app
# RUN curl -sS https://example.invalid/installer | php -- --check
# RUN composer diagnose
# RUN composer require predis/predis
RUN composer install --no-scripts

# 创建 crontab 文件
RUN echo "* * * * * cd /var/www/html && /usr/local/bin/php artisan schedule:run >> /dev/null 2>&1" > /etc/cron.d/laravel-scheduler
RUN chmod 0644 /etc/cron.d/laravel-scheduler
RUN crontab /etc/cron.d/laravel-scheduler

# 创建启动脚本
COPY build-dev/backend/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# 使用启动脚本替换原来的 CMD
CMD ["/usr/local/bin/docker-entrypoint.sh"]